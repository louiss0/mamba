import 'dart:io';
import 'package:mamba/mamba.dart';
import 'package:test/test.dart';
import 'completions.dart';
import 'support.dart' show ExampleStore;
void main() {
  test('custom completion command reads its intrinsic positional handles', () async {
    final directory = Directory.systemTemp.createTempSync('mamba-doc-completion-');
    addTearDown(() => directory.deleteSync(recursive: true));
    final path = '${directory.path}/tool.bash';
    final executor = Executor('tool', 'Tool.', '1.0.0', [GenerateCompletionCommand()]).fake();
    expect(await executor.execute(['completion', 'bash']),
      isA<MambaFailureResult>().having((result) => result.message, 'message',
        'A destination path is required.'));
    expect(await executor.execute(['completion', 'bash', path]),
      isA<MambaSuccessResult>().having((result) => result.output, 'output',
        'Wrote bash completions to $path.'));
    expect(File(path).readAsStringSync(), contains('complete -F'));
  });
