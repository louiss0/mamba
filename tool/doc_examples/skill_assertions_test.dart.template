import 'package:mamba/mamba.dart';
import 'package:test/test.dart';
import 'skill_commit.dart';

final class SimpleCommitCommand extends Command {
  @override
  String get name => 'commit';
  @override
  String get shortDescription => 'Commit.';
  @override
  String run(ParsedInputs inputs, List<String> args) => 'Committed README.md.';
}
final class FailingPushCommand extends Command with HookRunner {
  @override
  void preRun(ParsedInputs inputs, MambaReadContext context,
      ProcessedStandardInput? input) {}
  @override
  String get name => 'push';
  @override
  String get shortDescription => 'Push.';
  @override
  String run(ParsedInputs inputs, List<String> args) {
    throw MambaException('fatal: push rejected');
  }
  @override
  void postRun(ParsedInputs inputs, MambaReadContext context) {
    throw MambaException('failed to close transport');
  }
}
